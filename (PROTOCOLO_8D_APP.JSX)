// --- COMPONENTE INTERACTIVO DEL PASO 1 (CALCULADORA DE CAPITAL SEMILLA) ---
const Step1Calculator = ({ initialSalary = 350, initialRate = 36.35, setCopyStatus, copyStatus }) => {
    const [salary, setSalary] = useState(initialSalary.toString());
    const [bcvRate, setBcvRate] = useState(initialRate.toString());

    // Utilidad para copiar al portapapeles (compatible con iframe)
    const copyToClipboard = (text, callback) => {
        if (document.execCommand) {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            document.body.appendChild(textarea);
            textarea.select();
            try {
                document.execCommand('copy');
                callback(true);
            } catch (err) {
                callback(false);
            }
            document.body.removeChild(textarea);
        } else {
            navigator.clipboard.writeText(text).then(() => callback(true)).catch(() => callback(false));
        }
    };

    const calculatedValues = useMemo(() => {
        const sal = parseFloat(salary) || 0;
        const rate = parseFloat(bcvRate) || 0;

        const capitalSemillaUSD = sal * 0.10; 
        const capitalSemillaVES = capitalSemillaUSD * rate;

        return {
            totalVES: (sal * rate).toFixed(2),
            capitalSemillaVES: capitalSemillaVES.toFixed(2),
            capitalSemillaUSD: capitalSemillaUSD.toFixed(2),
            copyValue: capitalSemillaUSD.toFixed(2),
        };
    }, [salary, bcvRate]);

    const handleCopy = () => {
        const text = `Capital Semilla Mínimo a Blindar: $ ${calculatedValues.copyValue} USD (Bs. ${calculatedValues.capitalSemillaVES})`;
        copyToClipboard(text, (success) => {
            setCopyStatus(success ? 'copied_step1' : 'error');
            setTimeout(() => setCopyStatus(null), 3000);
