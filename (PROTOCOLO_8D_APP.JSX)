// --- COMPONENTE PRINCIPAL DE LA APLICACIÓN ---
const App = () => {
    // 1. Estados iniciales de la App
    const [currentStep, setCurrentStep] = useState(0); 
    const [copyStatus, setCopyStatus] = useState(null); 
    const [isLoading, setIsLoading] = useState(true);
    const [isSaving, setIsSaving] = useState(false); 
    const [firebaseError, setFirebaseError] = useState(null); 

    // 2b. Estados de Firebase/Auth
    const [db, setDb] = useState(null);
    const [auth, setAuth] = useState(null);
    const [userId, setUserId] = useState(null);
    const [isAuthReady, setIsAuthReady] = useState(false);
    
    // Almacena la referencia del paso actual para onSnapshot
    const currentStepRef = useRef(currentStep);
    
    // --- EFECTO A: MANTENER LA REFERENCIA SINCRONIZADA ---
    useEffect(() => {
        currentStepRef.current = currentStep;
    }, [currentStep]);

    // --- FUNCIÓN PARA GUARDAR EL PROGRESO EN FIRESTORE ---
    const saveProgress = useCallback(async (step) => {
        if (!db || !userId) return;
        
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';
        // Private Data Path: /artifacts/{appId}/users/{userId}/{your_collection_name}/{documentId}
        const userDocRef = doc(db, 'artifacts', appId, 'users', userId, 'protocolo_8d_progress', 'data');
        
        try {
            await setDoc(userDocRef, {
                currentStep: step,
                timestamp: new Date().toISOString(),
            }, { merge: true });
            console.log(`[ACTION] Progreso guardado en DB: Paso ${step}`);
        } catch (error) {
            console.error("Error guardando progreso en Firestore:", error);
        }
    }, [db, userId]);

    // --- EFECTO 1: Inicialización de Firebase y Autenticación (El Bloque Crítico) ---
    useEffect(() => {
        let app, firestore, authentication;
        let unsubscribeAuth = () => {};

        const initializeFirebase = async () => {
            try {
                // 1. Cargar dependencias de Firebase de forma dinámica y segura
                const firebaseApp = await import('https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js');
                const firebaseAuth = await import('https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js');
                const firebaseFirestore = await import('https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js');

                initializeApp = firebaseApp.initializeApp;
                getAuth = firebaseAuth.getAuth;
                signInAnonymously = firebaseAuth.signInAnonymously;
                signInWithCustomToken = firebaseAuth.signInWithCustomToken;
                onAuthStateChanged = firebaseAuth.onAuthStateChanged;
                
                getFirestore = firebaseFirestore.getFirestore;
                doc = firebaseFirestore.doc;
                setDoc = firebaseFirestore.setDoc;
                onSnapshot = firebaseFirestore.onSnapshot;

                // 2. Verificar Configuración
                const firebaseConfig = (() => {
                    try {
                        return typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : null;
                    } catch (e) {
                        throw new Error("Configuración de Firebase no válida o faltante.");
                    }
                })();

                if (!firebaseConfig) throw new Error("Configuración de Firebase no disponible.");

                // 3. Inicializar Servicios
                app = initializeApp(firebaseConfig);
                firestore = getFirestore(app);
                authentication = getAuth(app);
                
                setDb(firestore);
                setAuth(authentication);

                // 4. Autenticar
                const token = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;
                if (token) {
                    await signInWithCustomToken(authentication, token);
                } else {
                    await signInAnonymously(authentication);
                }

                // 5. Configurar Listener de Auth
                unsubscribeAuth = onAuthStateChanged(authentication, (user) => {
                    if (user) {
                        setUserId(user.uid);
                    } else {
                        setUserId(null);
                    }
                    setIsAuthReady(true);
                });

                setFirebaseError(null); // Borrar cualquier error si la inicialización es exitosa

            } catch (error) {
                console.error("Error Crítico al inicializar la plataforma:", error);
                setFirebaseError(`FALLO CRÍTICO DE CONEXIÓN: ${error.message}.`);
                setIsLoading(false);
            }
        };

        initializeFirebase();

        // Cleanup function
        return () => {
            unsubscribeAuth();
        };

    }, []); 

    // --- EFECTO 2: Leer y Sincronizar el progreso del usuario de Firestore (REQUIERE AUTH) ---
    useEffect(() => {
        if (!db || !userId || !isAuthReady || !onSnapshot || !doc) return; 

        const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';
        const userDocRef = doc(db, 'artifacts', appId, 'users', userId, 'protocolo_8d_progress', 'data');

        // Suscripción en tiempo real (onSnapshot)
        const unsubscribe = onSnapshot(userDocRef, (docSnap) => {
            if (docSnap.exists()) {
                const data = docSnap.data();
                const dbStep = data.currentStep || 0;
                
                if (dbStep !== currentStepRef.current) {
                    console.log(`[FIREBASE] Sincronización DB: Paso ${dbStep}.`);
                    setCurrentStep(dbStep);
                }
            } else {
                // If document doesn't exist, ensure we are on the welcome screen if the current state isn't 0
                if (currentStepRef.current !== 0) {
                     setCurrentStep(0);
                }
            }
            setIsLoading(false);
            setIsSaving(false); 
        }, (error) => {
            console.error("Error leyendo progreso en tiempo real:", error);
            setFirebaseError(`Error de sincronización de DB: ${error.message}`);
            setIsLoading(false);
            setIsSaving(false);
        });

        return () => unsubscribe(); 
    }, [db, userId, isAuthReady]);


    // --- LÓGICA DE NAVEGACIÓN (AVANZAR/RETROCEDER) ---
    const handleNextStep = useCallback(() => {
        if (currentStep === PROTOCOL_STEPS.length) {
            return; 
        }

        if (isSaving || currentStep >= PROTOCOL_STEPS.length) return;

        const nextStep = currentStep + 1;
        setIsSaving(true); 
        setCurrentStep(nextStep);
        saveProgress(nextStep);
        
        // Note: The saving state will be reset by the onSnapshot listener, which is better
        // setTimeout(() => setIsSaving(false), 300); 
        setCopyStatus(null);
    }, [currentStep, saveProgress, isSaving]);

    const handlePrevStep = useCallback(() => {
        if (isSaving || currentStep <= 1) return; 

        const prevStep = currentStep - 1;
        
        setIsSaving(true);
        setCurrentStep(prevStep);
        saveProgress(prevStep);

        // Note: The saving state will be reset by the onSnapshot listener
        // setTimeout(() => setIsSaving(false), 300); 
        setCopyStatus(null);
    }, [currentStep, saveProgress, isSaving]);

    const handleGoToStart = useCallback(() => {
        if (isSaving) return; 

        const startStep = 1;

        setIsSaving(true);
        setCurrentStep(startStep);
        saveProgress(startStep);

        // Note: The saving state will be reset by the onSnapshot listener
        // setTimeout(() => setIsSaving(false), 300); 
        setCopyStatus(null);
    }, [saveProgress, isSaving]);

    // --- UTILIDADES DE RENDERIZADO Y WHATSAPP ---
    // Clases CSS modernizadas y futuristas
    const styles = {
        bgClass: "bg-gray-950 min-h-screen flex items-start sm:items-center justify-center p-4 font-sans text-white",
        cardClass: "w-full max-w-lg bg-gray-900 p-6 sm:p-8 rounded-3xl shadow-3xl shadow-purple-900/50 border-t-8 border-cyan-400/80 transition-all duration-500",
        disabledBtnClass: "bg-gray-700 text-gray-400 cursor-not-allowed",
        enabledBtnClass: "bg-cyan-500 hover:bg-cyan-400 shadow-xl shadow-cyan-500/80",
        whatsappBtnClass: "bg-emerald-500 hover:bg-emerald-400 shadow-xl shadow-emerald-600/80 text-black", 
    };

    const generateWhatsAppLink = (message) => {
        const encodedMessage = encodeURIComponent(message);
        const cleanNumber = ADVISOR_INFO.WHATSAPP_NUMBER_ONLY.replace(/[^0-9]/g, ''); 
        return `https://wa.me/${cleanNumber}?text=${encodedMessage}`;
    };
    
    // --- HANDLER PARA EL BOTÓN DE WHATSAPP ---
    const handleWhatsAppClick = (message) => {
        const url = generateWhatsAppLink(message);
        // Intentar abrir la ventana
        const newWindow = window.open(url, '_blank', 'noopener,noreferrer');
        
        // Comprobar si la apertura fue bloqueada
        if (newWindow === null || newWindow.closed || typeof newWindow.closed === 'undefined') {
            setCopyStatus('open_blocked'); // Establecer el estado de bloqueo
            // El mensaje de advertencia se mostrará en el renderizado
        } else {
            newWindow.focus();
            setCopyStatus(null);
        }
    };


    const getButtonText = () => {
        if (isSaving) return "SINCRONIZANDO...";
        if (currentStep === 0) return "INICIAR MI LICENCIA ANTI-INFLACIÓN";
        if (currentStep < PROTOCOL_STEPS.length) return `SIGUIENTE: ${PROTOCOL_STEPS[currentStep].short}`; 
        return "CONTACTAR ASESOR HUMANO (VALIDAR GENERADOR DE RIQUEZA)";
    };
    
    const getButtonIcon = () => {
        if (isSaving) return <Loader className="w-5 h-5 ml-2 animate-spin" />;
        if (currentStep < PROTOCOL_STEPS.length) return <ArrowRight className="w-5 h-5 ml-2" />;
        return <MessageSquare className="w-5 h-5 ml-2" />;
    };

    const currentStepData = currentStep > 0 && currentStep <= PROTOCOL_STEPS.length ? PROTOCOL_STEPS[currentStep - 1] : null;

    const isPaymentStep = currentStep === 2;
    const isWalletStep = currentStep === 3;
    const isLastStep = currentStep === PROTOCOL_STEPS.length; 
    const isWelcomeScreen = currentStep === 0;
    const canGoBack = currentStep > 1;

    // Determina el enlace y el mensaje de WhatsApp según el paso
    const whatsappMessage = isPaymentStep ? WHATSAPP_MESSAGES.COMPROBANTE : 
                            isLastStep ? WHATSAPP_MESSAGES.ASESORIA : 
                            null;
    const currentLinkToCopy = whatsappMessage ? generateWhatsAppLink(whatsappMessage) : null;

    // Función de copia al portapapeles para el enlace directo
    const handleCopyLink = () => {
        if (currentLinkToCopy) {
            const copyToClipboardFunc = (text, callback) => {
                if (document.execCommand) {
                    const textarea = document.createElement('textarea');
                    textarea.value = text;
                    document.body.appendChild(textarea);
                    textarea.select();
                    try {
                        document.execCommand('copy');
                        callback(true);
                    } catch (err) {
                        callback(false);
                    }
                    document.body.removeChild(textarea);
                } else {
                    navigator.clipboard.writeText(text).then(() => callback(true)).catch(() => callback(false));
                }
            };
            
            copyToClipboardFunc(currentLinkToCopy, (success) => {
                setCopyStatus(success ? 'copied_link' : 'error');
                setTimeout(() => setCopyStatus(null), 3000);
            });
        }
    };


    // --- MANEJO DE VISTAS (CARGA Y ERROR) ---

    if (firebaseError) {
        return (
             <div className="flex items-center justify-center min-h-screen bg-gray-950 text-red-400 p-8">
                <div className="bg-gray-900 p-6 rounded-xl border-t-8 border-red-500 shadow-lg shadow-red-900/50 w-full max-w-lg">
                    <h2 className="text-3xl font-extrabold mb-4 flex items-center text-yellow-500">
                        <Zap className="w-8 h-8 mr-3 text-red-500"/> FALLA DE CONEXIÓN CRÍTICA
                    </h2>
                    <p className="text-lg mb-4 text-gray-300">
                        La herramienta digital no pudo iniciar el protocolo seguro.
                    </p>
                    <p className="text-sm font-mono bg-gray-800 p-3 rounded-lg overflow-x-auto break-words">
                        {firebaseError}
                    </p>
                    <p className="mt-4 text-sm text-gray-300">
                        Intente recargar el módulo.
                    </p>
                </div>
            </div>
        );
    }
    
    if (isLoading) {
        return (
            <div className="flex items-center justify-center min-h-screen bg-gray-950 text-cyan-400">
                <p className="text-xl font-bold animate-pulse flex items-center">
                    <Rocket className="w-6 h-6 mr-3 animate-bounce"/>
                    Activando Protocolo 8D: Carga Segura...
                </p>
            </div>
        );
    }
    
    // --- RENDERIZADO DEL PROTOCOLO (Si la carga fue exitosa) ---
    return (
        <div className={styles.bgClass}>
            
            <div className={styles.cardClass}>
                
                {/* CABECERA Y TÍTULO (Estilo Consola) */}
                <div className="flex justify-center items-center mb-6">
                    <div className="text-center flex-grow">
                        <Cpu className="w-12 h-12 mx-auto text-cyan-400 mb-2 animate-pulse" />
                        <h1 className="text-3xl sm:text-4xl font-extrabold tracking-tight text-white uppercase leading-tight">
                            Protocolo <span className='text-cyan-400'>8D</span>
                        </h1>
                        <p className="text-lg font-semibold text-emerald-500 mt-1">SISTEMA DE RIQUEZA DIGITAL (FINTECH)</p>
                    </div>
                </div>

                {/* INFO DEL ASESOR */}
                <div className="mt-4 p-3 bg-gray-800 rounded-xl border-l-4 border-cyan-500 text-center mb-8 shadow-inner shadow-cyan-900/30">
                    <p className="text-xs text-gray-400">Asesoría 24/7 con **{ADVISOR_INFO.NAME}**</p>
                    <p className="text-sm font-bold text-cyan-400 flex items-center justify-center">
                        <MessageSquare className="w-4 h-4 mr-2"/> WhatsApp: {ADVISOR_INFO.WHATSAPP_NUMBER_ONLY}
                    </p>
                </div>
                
                {/* INDICADOR DE PROGRESO */}
                <div className="mb-8 p-3 bg-gray-800 rounded-xl border border-gray-700 shadow-md">
                    <h2 className="text-xs font-bold uppercase tracking-wider text-cyan-400 mb-2">
                        SECUENCIA DE ACTIVACIÓN Y BLINDAJE
                    </h2>
                    <div className="flex items-center justify-between space-x-1">
                        {PROTOCOL_STEPS.map((step, index) => (
                            <div key={step.id} 
                                 className={`w-1/8 h-3 rounded-full transition-all duration-500 relative
                                            ${currentStep > index ? 'bg-emerald-500 shadow-lg shadow-emerald-700/50' : 
                                              currentStep === index + 1 ? 'bg-cyan-500 shadow-xl shadow-cyan-500/50 animate-pulse' : 
                                              'bg-gray-700'}`}>
                                <span className={`absolute -bottom-5 left-1/2 transform -translate-x-1/2 text-xs font-bold transition-opacity duration-300
                                                 ${currentStep === index + 1 ? 'text-cyan-400 opacity-100' : 'text-gray-500 opacity-0 sm:opacity-100'}`}>
                                    {step.id}
                                </span>
                            </div>
                        ))}
                    </div>
                    <p className="text-sm text-gray-400 mt-5 text-center">
                        PASO DE ENFOQUE: {currentStep} de {PROTOCOL_STEPS.length}
                    </p>
                </div>

                {/* CONTENIDO DIDÁCTICO */}
                <div className="min-h-[350px] mb-8">
                    {isWelcomeScreen ? (
                         <div className="text-center p-6 border-2 border-dashed border-emerald-600 rounded-xl bg-gray-900/50 shadow-lg shadow-emerald-900/40">
                            <h2 className="text-3xl font-bold text-white mb-3">
                                ¡CONSOLA ADI INICIADA!
                            </h2>
                            <p className="text-lg text-gray-300 mb-4 font-semibold">
                                Su **Herramienta Anti-Inflación** personal está lista. Acceda a la **Generación de Riqueza** con los 8 Pasos.
                            </p>
                            <div className="flex flex-col space-y-2 items-center text-sm font-mono text-cyan-400 font-extrabold p-3 bg-gray-800 rounded-lg">
                                <span className='flex items-center'><ShieldCheck className="w-4 h-4 mr-2 text-emerald-400" /> HERRAMIENTA ANTI-INFLACIÓN (BLINDAJE)</span>
                                <span className='flex items-center'><TrendingUp className="w-4 h-4 mr-2 text-purple-400" /> GENERADOR DE RIQUEZA (MONETIZACIÓN)</span>
                                <span className='flex items-center'><Cpu className="w-4 h-4 mr-2 text-yellow-400" /> ASESOR DIGITAL INTELIGENTE (ADI)</span>
                            </div>
                        </div>
                    ) : (
                        <>
                            <div className="p-4 bg-gray-800 rounded-xl shadow-inner border-l-4 border-emerald-500 mb-6">
                                <p className="text-sm uppercase text-gray-400 font-bold">MÓDULO {currentStep}</p>
                                <div className="flex items-center mt-1">
                                    <span className="text-2xl font-extrabold mr-3 text-cyan-400 leading-tight">{currentStepData.title}</span>
                                </div>
                            </div>
                            
                            {currentStep === 1 ? (
                                <Step1Calculator setCopyStatus={setCopyStatus} copyStatus={copyStatus} />
                            ) : isWalletStep ? (
                                <Step3WalletAdviser userId={userId} />
                            ) : isLastStep ? (
                                <DigitalAdvisor userId={userId} />
                            ) : (
                                <DidacticConsole stepData={currentStepData.content} />
                            )}
                        </>
                    )}
                </div>
                
                {/* BOTONES DE WHATSAPP (PAGO Y ASESORÍA) */}
                {(isPaymentStep || isLastStep) && (
                    <>
                        {isLastStep && (
                             <div className="mt-4 text-center p-4 bg-gray-800 rounded-xl border-l-4 border-emerald-500 mb-4 shadow-neon-emerald">
                                <p className="text-xl text-white font-extrabold mb-2 flex items-center justify-center">
                                    <CheckCircle className='w-6 h-6 mr-2 text-emerald-400'/> ¡PROTOCOLO 8D IMPLEMENTADO!
                                </p>
                                <p className="text-sm text-gray-400">
                                    **PASO FINAL:** Valide su estrategia de Monetización con el experto humano.
                                </p>
                            </div>
                        )}
                        
                        {/* MENSAJE DE ADVERTENCIA SI LA APERTURA FUE BLOQUEADA */}
                        {copyStatus === 'open_blocked' && (
                             <p className='text-center text-sm font-bold text-yellow-400 bg-red-900/50 p-2 rounded-lg mb-2 animate-pulse'>
                                ¡ADVERTENCIA! El navegador bloqueó la apertura. Usa el botón de abajo para COPIAR el enlace.
                             </p>
                        )}

                        <button 
                            onClick={() => handleWhatsAppClick(whatsappMessage)}
                            className={`w-full py-4 mb-3 flex flex-col items-center justify-center font-extrabold text-xl text-black rounded-xl shadow-lg transition-all duration-300 transform hover:scale-[1.01] active:scale-[0.99]
                                        ${isPaymentStep ? 'bg-yellow-400 hover:bg-yellow-300 shadow-yellow-700/80' : styles.whatsappBtnClass}`}
                        >
                            <div className='flex items-center'>
                                <CreditCard className="w-6 h-6 mr-3" />
                                {isPaymentStep ? `ACTIVAR LICENCIA DE RIQUEZA DIGITAL (${ADVISOR_INFO.PAGO_MOVIL.AMOUNT_USD})` : 'VALIDAR ESTRATEGIA DE RIQUEZA (WhatsApp)'}
                            </div>
                            <span className='text-xs font-semibold mt-1 text-red-700'>
                                (CLICK AQUÍ PARA CONTACTAR AL ASESOR HUMANO)
                            </span>
                        </button>
                        
                        
                        {/* BOTÓN DE COPIAR ENLACE DIRECTO (FALLBACK) */}
                        <div className="text-center mb-4 p-4 bg-gray-800 rounded-xl border-2 border-red-500/50">
                            <p className="text-sm font-bold text-red-400 mb-2 uppercase tracking-wider">
                                **SOLUCIÓN SI EL CHAT NO ABRE**
                            </p>
                            <button 
                                onClick={handleCopyLink}
                                disabled={isSaving}
                                className={`w-full py-3 flex items-center justify-center text-lg font-extrabold rounded-xl transition-colors duration-300 transform hover:scale-[1.01]
                                    ${isSaving ? styles.disabledBtnClass : 
                                    copyStatus === 'copied_link' ? 'bg-green-600 text-white shadow-green-700/80' : 
                                    copyStatus === 'error' ? 'bg-red-600 text-white shadow-red-700/80' : 
                                    'bg-gray-700 hover:bg-gray-600 text-white shadow-gray-700/80'}`}
                            >
                                {copyStatus === 'copied_link' ? 
                                 <>
                                    <CheckCircle className="w-5 h-5 mr-2" />
                                    ¡ENLACE COPIADO! ¡PÉGALO EN TU CHAT DE WHATSAPP!
                                 </> :
                                 copyStatus === 'error' ? 'Error al Copiar' :
                                 <>
                                    <Link className="w-5 h-5 mr-2" />
                                    COPIAR ENLACE DIRECTO ({isLastStep ? 'ASESORÍA' : 'PAGO'})
                                </>}
                            </button>
                        </div>
                    </>
                )}


                {/* BOTÓN PRINCIPAL: Siguiente / Iniciar */}
                {!isLastStep ? (
                    <button 
                        onClick={handleNextStep} 
                        disabled={isSaving}
                        className={`w-full py-4 flex items-center justify-center font-extrabold text-xl text-black rounded-xl transition-all duration-300 transform active:scale-[0.98]
                                    ${isSaving ? styles.disabledBtnClass : 'bg-gradient-to-r from-cyan-400 to-purple-400 hover:from-cyan-300 hover:to-purple-300 shadow-xl shadow-cyan-500/80'}`}
                    >
                        {getButtonText()}
                        {getButtonIcon()}
                    </button>
                ) : (
                    <p className="text-center text-gray-500 text-sm italic mt-4">
                        *El Generador de Riqueza ADI ha trazado el plan. Siga el paso superior.
                    </p>
                )}

                {/* BARRA DE NAVEGACIÓN INFERIOR (Retroceso y Home) */}
                {!isWelcomeScreen && (
                    <div className="flex justify-center space-x-4 mt-6 border-t border-gray-800 pt-4">
                        <button 
                            onClick={handlePrevStep}
                            disabled={!canGoBack || isSaving}
                            className={`px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-300 
                                ${!canGoBack || isSaving ? 'bg-gray-800 text-gray-600 cursor-not-allowed' : 'bg-gray-700 hover:bg-gray-600 text-white'}`}
                        >
                            <ArrowLeft className="w-5 h-5 inline mr-1" />
                            Paso Anterior
                        </button>
                        
                        <button 
                            onClick={handleGoToStart}
                            disabled={isSaving}
                            className={`px-4 py-2 rounded-xl text-sm font-semibold transition-colors duration-300
                                ${isSaving ? 'bg-gray-800 text-gray-600 cursor-not-allowed' : 'bg-gray-700 hover:bg-gray-600 text-cyan-400'}`}
                        >
                            <Home className="w-5 h-5 inline mr-1" />
                            Paso 1: Diagnóstico
                        </button>
                    </div>
                )}
                
                {/* FOOTER Y USER ID */}
                <div className="mt-6 text-center text-xs text-gray-600 border-t border-gray-800 pt-3">
                    {ADVISOR_INFO.SLOGAN}
                </div>
                <p className="text-xs text-center text-gray-700 mt-2">
                    ID de Sesión: {userId || 'Cargando...'}
                </p>
            </div>
        </div>
    );
};

export default App;